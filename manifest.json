{
  "manifest_version": 3,
  "name": "myQU Banner — UI Enhancer",
  "version": "0.1.0",
  "description": "Restyles mybanner.qu.edu.qa in place. Two themes (QU maroon / ACM mint), light and dark, EN and AR. Same server, same pages, same data.",
  "permissions": ["storage"],
  "host_permissions": ["https://mybanner.qu.edu.qa/*"],
  "content_scripts": [
    {
      "matches": ["https://mybanner.qu.edu.qa/*"],
      "css": ["src/skin.css"],
      "js": ["src/enhance.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://mybanner.qu.edu.qa/*"]
    }
  ],
  "action": { "default_popup": "src/popup.html" }
}
