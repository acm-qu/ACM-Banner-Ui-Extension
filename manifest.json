{
  "manifest_version": 3,
  "name": "ACM Banner Redesign",
  "version": "1.2.0",
  "description": "Restyles mybanner.qu.edu.qa in place. Two themes (QU / ACM), light and dark, EN and AR. Same server, same pages, same data.",
  "permissions": ["storage"],
  "host_permissions": ["https://mybanner.qu.edu.qa/*"],
  "content_scripts": [
    {
      "matches": ["https://mybanner.qu.edu.qa/*"],
      "css": ["src/skin.css"],
      "js": ["src/enhance.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://mybanner.qu.edu.qa/*"]
    }
  ],
  "icons": {
    "16": "assets/icon/16.png",
    "32": "assets/icon/32.png",
    "48": "assets/icon/48.png",
    "128": "assets/icon/128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ACM Banner Redesign",
    "default_icon": {
      "16": "assets/icon/16.png",
      "32": "assets/icon/32.png",
      "48": "assets/icon/48.png",
      "128": "assets/icon/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "banner-redesign@qu.acm.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
